<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Road Health Directory"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2E7D32" />

    <EditText
        android:id="@+id/etSearchRoad"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@android:drawable/editbox_background_normal"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="Search road name..."
        android:padding="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent Road Reports"
        android:layout_marginTop="20dp"
        android:textColor="#666666"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <RelativeLayout
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/roadName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MG Road, Bengaluru"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_below="@id/roadName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: No Damage"
                        android:textColor="#2E7D32"/>
                    <TextView
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOOD"
                        android:background="#E8F5E9"
                        android:padding="5dp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <RelativeLayout
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/roadName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hosur Road"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_below="@id/roadName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: 12 Potholes reported"
                        android:textColor="#C62828"/>
                    <TextView
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BAD"
                        android:background="#FFEBEE"
                        android:padding="5dp"
                        android:textColor="#C62828"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>